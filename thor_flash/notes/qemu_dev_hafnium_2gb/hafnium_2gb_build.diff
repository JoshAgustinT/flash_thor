@@ -12,7 +12,7 @@
 		compatible = "arm,sp";
 		op-tee {
 		       uuid = "486178e0-e7f8-11e3-bc5e-0002a5d5c51b";
-		       load-address = <0xe300000>;
+		       load-address = <0x30 0x00000000>; /* large secure TA RAM */
 		};
 	};
 };
